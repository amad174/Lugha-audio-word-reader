rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && userDoc().orgId == orgId;
    }

    function isTeacher(orgId) {
      return isOrgMember(orgId) && userDoc().role == 'teacher';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    match /inviteCodes/{code} {
      // Students resolve codes before account creation (signup flow).
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSignedIn();
    }

    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isSignedIn();
      allow update: if isTeacher(orgId);

      match /categories/{categoryId} {
        allow read: if isOrgMember(orgId);
        allow write: if isTeacher(orgId);
      }

      match /books/{bookId} {
        allow read: if isOrgMember(orgId);
        allow write: if isTeacher(orgId);

        match /pages/{pageId} {
          allow read: if isOrgMember(orgId);
          allow write: if isTeacher(orgId);
        }

        match /audio/{boxId} {
          allow read: if isOrgMember(orgId);
          allow write: if isTeacher(orgId);
        }
      }

      match /members/{memberId} {
        allow read: if isOrgMember(orgId);
        allow create: if isSignedIn() && request.auth.uid == memberId;
        allow update, delete: if isTeacher(orgId);
      }

      match /progress/{studentId} {
        allow read: if isOrgMember(orgId) && (request.auth.uid == studentId || isTeacher(orgId));
        allow create: if isSignedIn() && request.auth.uid == studentId;
        allow update: if isOrgMember(orgId) && request.auth.uid == studentId;
      }

      match /settings/{docId} {
        allow read: if isOrgMember(orgId);
        allow write: if isTeacher(orgId);
      }
    }
  }
}
